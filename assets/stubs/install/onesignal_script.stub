  <!-- OneSignal Web SDK. Do NOT call OneSignal.init() here: the Dart driver
       initializes from lib/config/notifications.dart, which is also where the
       scoped service_worker_path / service_worker_scope live so OneSignal's
       worker does not claim the root scope Flutter's own worker registers. -->
  <script src="https://cdn.onesignal.com/sdks/web/v16/OneSignalSDK.page.js" defer></script>
  <script>
    window.OneSignalDeferred = window.OneSignalDeferred || [];
  </script>
